# ==========================================
# EnerTrack — .gitignore
# ==========================================

# البيئة الافتراضية (venv) — كل جهاز يبنيها بنفسه من requirements.txt
venv/
env/
*.egg-info/

# ملفات بايثون المؤقتة/المُصرَّفة — تتولد تلقائيًا، ما لها داعي بالمستودع
__pycache__/
*.pyc
*.pyo

# قاعدة بيانات SQLite القديمة — المشروع يستخدم MySQL، هذا الملف بقايا مو مستخدمة
db.sqlite3

# بيانات مُصدَّرة من النوتبوك — كبيرة الحجم وقابلة لإعادة التوليد، ما تُرفع
django_import.csv
django_forecast_import.csv

# نماذج الذكاء الاصطناعي المحفوظة (لو نُقلت محليًا لاحقًا) — تُعاد توليدها من النوتبوك
models/*.joblib

# إعدادات محرر VS Code الشخصية (اختياري — احذفي هذا السطر لو تبون تشاركون نفس الإعدادات)
.vscode/

# ملفات نظام التشغيل
.DS_Store
Thumbs.db

# سجلات وملفات مؤقتة
*.log
*.tmp

__pycache__/
*.pyc
